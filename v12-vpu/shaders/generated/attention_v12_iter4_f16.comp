#version 450
#extension GL_EXT_shader_float16 : enable
// iter4 twin, R2-isolated PRECISION lever ONLY: score MAC in float16 (f32 accumulator),
// identical topology/grid/WG/buffers/dispatch to attention_v12_iter4.comp.
// Contract: op=matvec(f32 key[n,64] x f32 q[64]); N=HEAD_DIM=64; M=n (grid n,1,1);
// dtype f32 buffers -> f16 MUL -> f32 ACC -> f32 store; tol(atol=5e-3, precision lever);
// dispatch count=REPS; WG=64 (2x32 subgroups); bytes written=n*n*4 (scores f32).
layout(local_size_x = 64) in;
layout(set=0, binding=0, std430) readonly buffer Hidden { vec4 hidden4[]; };
layout(set=0, binding=1, std430) writeonly buffer Scores { float outData[]; };
#include "pc.h"
#define HEAD_DIM 64
#define VEC4 4
#define WG 64
#define STRIDE 68
shared float s_hidden[64 * STRIDE];   // mirror iter4 structure (R2: only MAC precision differs)

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wid = gl_WorkGroupID.x;
    uint k = pc.count;
    if (wid >= k) return;
    float scale = 1.0 / sqrt(float(HEAD_DIM));
    uint n4 = HEAD_DIM / VEC4;
    float16_t q[HEAD_DIM];
    for (uint d = 0; d < n4; d++) {
        vec4 v = hidden4[wid * n4 + d];
        q[d*4+0] = float16_t(v.x); q[d*4+1] = float16_t(v.y);
        q[d*4+2] = float16_t(v.z); q[d*4+3] = float16_t(v.w);
    }
    for (uint c = tid; c < k; c += WG) {
        float16_t key[HEAD_DIM];
        for (uint d = 0; d < n4; d++) {
            vec4 v = hidden4[c * n4 + d];
            key[d*4+0] = float16_t(v.x); key[d*4+1] = float16_t(v.y);
            key[d*4+2] = float16_t(v.z); key[d*4+3] = float16_t(v.w);
        }
        float acc = 0.0;                 // f32 accumulator vs iter4: the ONLY variable is the f16 MUL
        for (uint d = 0; d < HEAD_DIM; d++)
            acc += float(q[d] * key[d]); // f16 product, f32 accumulate
        outData[wid * k + c] = acc * scale;
    }
}
