#version 450
// V12-VPU fused attention (simplified tiled)
// 1D compute routing (local_size_x=64)
layout(local_size_x = 64) in;
layout(set=0, binding=0, std430) readonly buffer Hidden { float hidden[]; };
layout(set=0, binding=1, std430) writeonly buffer Scores { float outData[]; };
#include "pc.h"
#define HEAD_DIM 64
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint k = pc.count;
    if (i >= k * k) return;
    uint row = i / k;
    uint col = i % k;
    float acc = 0.0;
    for (uint d = 0; d < HEAD_DIM; d++)
        acc += hidden[row * HEAD_DIM + d] * hidden[col * HEAD_DIM + d];
    outData[i] = acc / sqrt(float(HEAD_DIM));
}
