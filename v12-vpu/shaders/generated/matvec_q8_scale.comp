#version 450
// V12-VPU generated: unfused matvec_q8 stage 2: scale accumulator → output
layout(local_size_x = 64) in;
layout(set=0, binding=2, std430) readonly buffer Acc  { int accs[]; };
layout(set=0, binding=3, std430) readonly buffer Scale { float scales[]; };
layout(set=0, binding=4, std430) writeonly buffer Out { float outData[]; };
#include "pc.h"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    outData[i] = float(accs[i]) * scales[i];
}
