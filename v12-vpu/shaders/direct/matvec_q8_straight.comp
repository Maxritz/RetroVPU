#version 450
// Path 1: Direct Vulkan, straightforward quantised int8 matrix-vector multiply
// M rows x K cols, int8 packed 4-per-uint32 (row-major).
layout(local_size_x = 64) in;
layout(set=0, binding=0, std430) readonly buffer MatW   { uint matW[]; };   // ceil(M*K/4) uints
layout(set=0, binding=1, std430) readonly buffer VecX   { uint vecX[]; };   // ceil(K/4) uints
layout(set=0, binding=2, std430) readonly buffer Scale  { float scales[]; };
layout(set=0, binding=3, std430) writeonly buffer Out   { float outData[]; };
#include "pc.h"

int unpack_i8(uint word, uint lane) {
    int val = int((word >> (lane * 8u)) & 0xFFu);
    if (val >= 128) val -= 256;
    return val;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    int acc = 0; uint k = pc.width; uint kv4 = (k + 3u) / 4u;
    for (uint j = 0; j < k; j++) {
        uint u32 = i * kv4 + j / 4u;
        uint lane = j % 4u;
        int w = unpack_i8(matW[u32], lane);
        int x = unpack_i8(vecX[j / 4u], lane);
        acc += w * x;
    }
    outData[i] = float(acc) * scales[i];
}
