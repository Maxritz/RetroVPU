#version 450
// Simple attention: compute scaled dot-product scores
// One row per workgroup (64 threads), each thread computes ~1 column
layout(local_size_x = 64) in;
layout(set=0, binding=0, std430) readonly buffer Hidden { float hidden[]; };
layout(set=0, binding=1, std430) writeonly buffer Scores { float outData[]; };
#include "pc.h"
#define HEAD_DIM 64
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wid = gl_WorkGroupID.x;
    uint k = pc.count;
    if (wid >= k) return;
    for (uint c = tid; c < k; c += 64u) {
        float acc = 0.0;
        for (uint d = 0u; d < HEAD_DIM; d++)
            acc += hidden[wid * HEAD_DIM + d] * hidden[c * HEAD_DIM + d];
        outData[wid * k + c] = acc / sqrt(float(HEAD_DIM));
    }
}
