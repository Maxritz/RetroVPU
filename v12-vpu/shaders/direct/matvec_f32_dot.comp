#version 450
// Direct Vulkan, unfused matvec_f32 stage 2: add second half and output
// Binding 0=matA(in), 1=vecB(in), 2=scratch(in partial sums), 4=output(out)
layout(local_size_x = 64) in;
layout(set=0, binding=0, std430) readonly buffer Mat  { float matA[]; };
layout(set=0, binding=1, std430) readonly buffer Vec  { float vecB[]; };
layout(set=0, binding=2, std430) readonly buffer Scr { float scratch[]; };
layout(set=0, binding=4, std430) writeonly buffer Out { float outData[]; };
#include "pc.h"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    uint base = i * pc.width;
    float acc = scratch[i];  // partial sum from stage 1
    uint half_k = pc.width / 2u;
    for (uint j = half_k; j < pc.width; j++)
        acc += matA[base + j] * vecB[j];
    outData[i] = acc;
}
