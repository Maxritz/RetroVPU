#version 450
// Direct Vulkan, unfused transform stage 2/3: SCALE_BIAS
// Binding 2=scratch1(in), 3=scratch2(out)
layout(local_size_x = 64) in;
layout(set=0,binding=2,std430) readonly buffer Scr1 { vec4 scratch1[]; };
layout(set=0,binding=3,std430) writeonly buffer Scr2 { vec4 scratch2[]; };
#include "pc.h"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    scratch2[i] = scratch1[i] * pc.scale + pc.sbbias;
}
