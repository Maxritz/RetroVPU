#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#ifdef V12_TRACE
#extension GL_EXT_shader_realtime_clock : enable
#endif
// matvec_gguf_v12_scan.comp - R2 twin of matvec_gguf_v12.comp: IDENTICAL body,
// ONLY the final reduction topology differs (the single variable under test):
//   prod : subgroupAdd(acc) -> every lane gets the sum -> lane0 fans in s_part.
//   scan : subgroupInclusiveAdd(acc) -> lane(last) carries the SG total -> single SG-lane
//          writes s_part[gl_SubgroupID]; workgroup lane0 fans in gl_NumSubgroups.
// Same decode (wdec), same a8(), same wsc0/wmn0 once-per-group scale, same integer dot,
// no dequant, gl_NumSubgroups-driven fan-in (== the correctness fix). Provenance: clean-room.
#include "gguf_decode.glsl"
#include "v12_trace.glsl"
#ifndef LOCAL_X
#define LOCAL_X 128
#endif
const uint MIN_SUBGROUP = 8u;
shared float s_part[LOCAL_X / MIN_SUBGROUP];
layout(local_size_x = LOCAL_X) in;

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.count) return;
    uint rb = row * ((pc.width / BLK) * BPB);
    uint ng = pc.width / GROUP;
    uint lane = gl_LocalInvocationID.x;
    float acc = 0.0;
    uint tDec = 0u, tMac = 0u, tScl = 0u, tRed = 0u;
    for (uint g = lane; g < ng; g += LOCAL_X) {
        float wsc0 = 0.0, wmn0 = 0.0;
        int S = 0, T = 0;
        uvec2 t = v12_now();
        for (uint l = 0u; l < GROUP; ++l) {
            int c; float ws, wm;
            wdec(g * GROUP + l, rb, c, ws, wm);
            uvec2 t1 = v12_now(); tDec += v12_dt(t, t1); t = t1;
            if (l == 0u) { wsc0 = ws; wmn0 = wm; }
            S += c * a8(g * GROUP + l);
            T += a8(g * GROUP + l);
            t = v12_now(); tMac += v12_dt(t1, t);
        }
        uvec2 t2 = v12_now(); tScl += v12_dt(t, t2); t = t2;
        acc += ad[g] * (wsc0 * float(S) - wmn0 * float(T));
    }
    uvec2 tRedStart = v12_now();
    // --- reduce (THE variant): scan-based subgroup total, then SG-total fan-in ---
    acc = subgroupInclusiveAdd(acc);                      // prefix sum within this subgroup
    if (gl_SubgroupInvocationID == (gl_SubgroupSize - 1u))
        s_part[gl_SubgroupID] = acc;                      // SG total, written by trailing lane
    barrier();
    if (lane == 0u) {
        float t_ = 0.0;
        for (uint s = 0u; s < gl_NumSubgroups; ++s) t_ += s_part[s];   // gl_NumSubgroups fan-in
        outv[row] = t_;
    }
    uvec2 tr = v12_now(); tRed += v12_dt(tRedStart, tr);
    V12_TRACE_STORE(row * LOCAL_X + lane, tDec, tMac, tScl, tRed);
}
