#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#ifdef V12_TRACE
#extension GL_EXT_shader_realtime_clock : enable
#endif
// V12 organization: one workgroup per row; lanes stride over K groups, subgroup
// reduction. Real GGUF weight bytes, integer accumulation, no dequant.
// Compile with -DV12_TRACE to record per-region GPU ticks (see v12_trace.glsl).
#include "gguf_decode.glsl"
#include "v12_trace.glsl"
#ifndef LOCAL_X
#define LOCAL_X 128
#endif
const uint MIN_SUBGROUP = 8u;   // Xe-LPG min subgroupSize (observed scales down for small WG)
shared float s_part[LOCAL_X / MIN_SUBGROUP];
layout(local_size_x = LOCAL_X) in;

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.count) return;
    uint rb = row * ((pc.width / BLK) * BPB);
    uint ng = pc.width / GROUP;
    uint lane = gl_LocalInvocationID.x;
    float acc = 0.0;
    uint tDec = 0u, tMac = 0u, tScl = 0u, tRed = 0u;
    for (uint g = lane; g < ng; g += LOCAL_X) {
        float wsc0 = 0.0, wmn0 = 0.0;
        int S = 0, T = 0;
        uvec2 t = v12_now();
        for (uint l = 0u; l < GROUP; ++l) {
            int c; float ws, wm;
            wdec(g * GROUP + l, rb, c, ws, wm);
            uvec2 t1 = v12_now(); tDec += v12_dt(t, t1); t = t1;
            if (l == 0u) { wsc0 = ws; wmn0 = wm; }
            S += c * a8(g * GROUP + l);
            T += a8(g * GROUP + l);
            t = v12_now(); tMac += v12_dt(t1, t);
        }
        uvec2 t2 = v12_now(); tScl += v12_dt(t, t2); t = t2;
        acc += ad[g] * (wsc0 * float(S) - wmn0 * float(T));
    }
    uvec2 tRedStart = v12_now();
    acc = subgroupAdd(acc);
    if (gl_SubgroupInvocationID == 0u) s_part[gl_SubgroupID] = acc;
    barrier();
    if (lane == 0u) {
    float t = 0.0;
    for (uint s = 0u; s < gl_NumSubgroups; ++s) t += s_part[s];
        outv[row] = t;
    }
    uvec2 tr = v12_now(); tRed += v12_dt(tRedStart, tr);
    V12_TRACE_STORE(row * LOCAL_X + lane, tDec, tMac, tScl, tRed);
}
