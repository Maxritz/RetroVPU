@dataclass
class TransferRing:
    """Ring buffer for async staging uploads."""
    chunk_size: int = 65536
    current: bytearray = field(default_factory=lambda: bytearray(65536))
    offset: int = 0
    chunks: list[bytes] = field(default_factory=list)

    def allocate(self, size: int) -> int:
        if size > self.chunk_size:
            self.chunk_size = size
            self.current = bytearray(size)
            self.offset = 0
        if self.offset + size > len(self.current):
            self.chunks.append(bytes(self.current))
            self.current = bytearray(self.chunk_size)
            self.offset = 0
        off = self.offset
        self.offset += size
        return off

    def write(self, data: bytes, offset: int):
        self.current[offset:offset + len(data)] = data


class GgufZeroCopy:
    """Zero-copy GGUF loader: mmap the file and create tensor views
    without copying to GPU memory.

    Parses GGUF v1/v2/v3 format per the official spec:
    https://github.com/ggml-org/ggml/blob/master/docs/gguf.md

    Header = magic(4) + version(4) + tensor_count(8) + metadata_kv_count(8).
    Tensor data offset is computed by sequentially parsing metadata + tensor info.
    """

    # GGUF metadata value types (gguf_metadata_value_type enum)
    GGUF_VAL_UINT8   = 0
    GGUF_VAL_INT8    = 1
    GGUF_VAL_UINT16  = 2
    GGUF_VAL_INT16   = 3
    GGUF_VAL_UINT32  = 4
    GGUF_VAL_INT32   = 5
    GGUF_VAL_FLOAT32 = 6
    GGUF_VAL_BOOL    = 7
    GGUF_VAL_STRING  = 8
    GGUF_VAL_ARRAY   = 9
    GGUF_VAL_UINT64  = 10
    GGUF_VAL_INT64   = 11
    GGUF_VAL_FLOAT64 = 12

    # Scalar value sizes (bytes) and struct formats, excluding STRING/ARRAY
    _VAL_SIZES = {0:1, 1:1, 2:2, 3:2, 4:4, 5:4, 6:4, 7:1, 10:8, 11:8, 12:8}
    _VAL_FORMATS = {0:'B', 1:'b', 2:'H', 3:'h', 4:'I', 5:'i', 6:'f', 7:None, 10:'Q', 11:'q', 12:'d'}

    # GGML tensor type sizes: (bytes_per_block, block_size_in_elements)
    _GGML_TYPE_SIZES = {
        0:  (4, 1),    # F32
        1:  (2, 1),    # F16
        2:  (18, 32),  # Q4_0
        3:  (20, 32),  # Q4_1
        6:  (22, 32),  # Q5_0
        7:  (24, 32),  # Q5_1
        8:  (34, 32),  # Q8_0
        9:  (36, 32),  # Q8_1
        10: (84, 256), # Q2_K  (block_q2_K: 16+64+2+2)
        11: (110, 256),# Q3_K  (block_q3_K: 32+64+12+2)
        12: (144, 256),# Q4_K  (block_q4_K: 2+2+12+128)
        13: (176, 256),# Q5_K  (block_q5_K: 2+2+12+32+128)
        14: (210, 256),# Q6_K  (block_q6_K: 128+64+16+2)
        16: (2, 16),   # IQ2_XS (2 bits/element, 16 elem block)
        17: (2, 16),   # IQ2_S
        18: (2, 16),   # IQ3_XXS
        20: (2, 8),    # IQ4_NL (2 bits/element, 8 elem block -> 16 bit block)
        23: (2, 8),    # IQ4_XS (2 bits/element, 8 elem block)
        24: (1, 1),    # I8
        25: (2, 1),    # I16
        26: (4, 1),    # I32
        27: (8, 1),    # I64
        28: (8, 1),    # F64
        30: (2, 1),    # BF16
        34: (6, 1),    # TQ1_0
        35: (6, 1),   # TQ2_0
        39: (1, 32),   # MXFP4
    }

    _DTYPE_NAMES = {0:'f32', 1:'f16', 2:'q4_0', 3:'q4_1', 6:'q5_0', 7:'q5_1',
                    8:'q8_0', 9:'q8_1', 10:'q2_k', 11:'q3_k', 12:'q4_k', 13:'q5_k',
                    14:'q6_k', 16:'iq2_xs', 17:'iq2_s', 18:'iq3_xxs', 20:'iq4_nl',
                    23:'iq4_xs', 24:'i8', 25:'i16', 26:'i32', 27:'i64', 28:'f64',
                    30:'bf16', 34:'tq1_0', 35:'tq2_0', 39:'mxfp4'}

    # GGUF spec: tensor_info struct field order is:
    #   name (gguf_string), n_dimensions (uint32), dimensions[n] (uint64[]),
    #   type (ggml_type/uint32), data_offset (uint64)
    # Note: dtype comes AFTER dimensions, not before.

    def __init__(self, path: str, parallel: bool = True, max_workers: int | None = None):
        self.path = path
        self.tensors: dict[str, dict] = {}
        self.metadata: dict[str, any] = {}
        self._fd = None
        self._mmap = None
        self.alignment = 32
        self.load_time_sec = 0
        self.parallel = parallel
        self.max_workers = max_workers

    @staticmethod
    def _align(offset: int, alignment: int) -> int:
        """GGUF align_offset: offset rounded up to next multiple of alignment."""
        return (offset + alignment - 1) & ~(alignment - 1)

    @staticmethod
    def _skip_string(data: bytes | mmap.mmap, pos: int, n: int) -> int:
        """Skip a GGUF string (uint64 len + bytes), no alignment."""
        slen = struct.unpack_from('<Q', data, pos)[0]
        if pos + 8 + slen > n:
            raise ValueError(f"String length {slen} at pos {pos} overflows file")
        return pos + 8 + slen

    @classmethod
    def _skip_value(cls, data: bytes | mmap.mmap, pos: int, val_type: int, n: int) -> int:
        """Skip a GGUF metadata value, return new position. No inter-field alignment.

        Returns the number of bytes consumed or raises ValueError on malformed data.
        """
        if val_type == cls.GGUF_VAL_STRING:
            return cls._skip_string(data, pos, n)
        elif val_type == cls.GGUF_VAL_ARRAY:
            # SPEC: type (uint32) FIRST, then len (uint64)
            if pos + 12 > n:
                raise ValueError(f"Array header overflows at pos {pos}")
            arr_type = struct.unpack_from('<I', data, pos)[0]
            pos += 4
            arr_len = struct.unpack_from('<Q', data, pos)[0]
            pos += 8
            return cls._skip_array_elements(data, pos, arr_type, arr_len, n)
        elif val_type == cls.GGUF_VAL_BOOL:
            return pos + 1
        elif val_type in cls._VAL_SIZES:
            return pos + cls._VAL_SIZES[val_type]
        else:
            raise ValueError(f"Unknown GGUF value type: {val_type}")

    @classmethod
    def _skip_array_elements(cls, data: bytes | mmap.mmap, pos: int,
                             arr_type: int, arr_len: int, n: int) -> int:
        """Skip array elements given type and length (no header re-read)."""
        if arr_type == cls.GGUF_VAL_STRING:
            for _ in range(arr_len):
                pos = cls._skip_string(data, pos, n)
        elif arr_type == cls.GGUF_VAL_BOOL or arr_type in (0, 1):
            pos += arr_len
        elif arr_type in cls._VAL_SIZES:
            pos += arr_len * cls._VAL_SIZES[arr_type]
        else:
            raise ValueError(f"Unknown array element type {arr_type}")
        if pos > n:
            raise ValueError(f"Array elements overflow at pos {pos} (len={arr_len})")
        return pos

    @classmethod
    def _read_value(cls, data: bytes | mmap.mmap, pos: int, val_type: int) -> tuple:
        """Read a GGUF metadata scalar value. Returns (value, new_pos)."""
        sz = cls._VAL_SIZES[val_type]
        fmt = cls._VAL_FORMATS[val_type]
        if fmt is None:  # BOOL
            return data[pos] != 0, pos + 1
        return struct.unpack_from('<' + fmt, data, pos)[0], pos + sz

    def load(self):
        import time
        import math
        t0 = time.perf_counter()

        self._fd = open(self.path, 'rb')
        self._mmap = mmap.mmap(self._fd.fileno(), 0, access=mmap.ACCESS_READ)
        data = self._mmap
        n = len(data)

        if data[:4] != b"GGUF":
            raise ValueError('Not a GGUF file (magic mismatch)')

        # Batched header read: version, tensor_count, metadata_kv_count
        self.version, tensor_count, metadata_kv_count = struct.unpack_from('<IQQ', data, 4)
        if self.version not in (1, 2, 3):
            raise ValueError(f"Unsupported GGUF version: {self.version}")

        # GGUF spec: metadata fields are sequential WITHOUT inter-field alignment.
        # general.alignment can appear anywhere; default is 32 when absent.
        # Skip large tokenizer arrays (vocab_size elements) to avoid materializing them.
        vocab_size = 0
        alignment = 32
        pos = 24  # header size: 4+4+8+8
        for i in range(metadata_kv_count):
            key_len = struct.unpack_from('<Q', data, pos)[0]
            pos += 8
            key = data[pos:pos + key_len].decode('utf-8')
            pos += key_len

            val_type = struct.unpack_from('<I', data, pos)[0]
            pos += 4

            if val_type == self.GGUF_VAL_STRING:
                slen = struct.unpack_from('<Q', data, pos)[0]
                pos += 8
                val = data[pos:pos + slen].decode('utf-8')
                pos += slen
                self.metadata[key] = val
            elif val_type == self.GGUF_VAL_ARRAY:
                # SPEC: type (uint32) FIRST, then len (uint64)
                arr_type = struct.unpack_from('<I', data, pos)[0]
                pos += 4
                arr_len = struct.unpack_from('<Q', data, pos)[0]
                pos += 8
                # Skip large tokenizer arrays (vocab_size elements) — zero-copy loader
                # doesn't need token strings. Read only small arrays.
                if key in ('tokenizer.ggml.tokens', 'tokenizer.ggml.merges',
                           'tokenizer.ggml.scores', 'tokenizer.ggml.token_type'):
                    pos = self._skip_array_elements(data, pos, arr_type, arr_len, n)
                    self.metadata[key] = {'_skipped': True, 'arr_type': arr_type, 'arr_len': arr_len}
                else:
                    arr_vals = []
                    for _ in range(arr_len):
                        if arr_type == self.GGUF_VAL_STRING:
                            slen = struct.unpack_from('<Q', data, pos)[0]
                            pos += 8
                            arr_vals.append(data[pos:pos+slen].decode('utf-8'))
                            pos += slen
                        elif arr_type == self.GGUF_VAL_BOOL:
                            arr_vals.append(data[pos] != 0)
                            pos += 1
                        elif arr_type in self._VAL_SIZES:
                            val, pos = self._read_value(data, pos, arr_type)
                            arr_vals.append(val)
                        else:
                            raise ValueError(f"Unknown array element type {arr_type}")
                    self.metadata[key] = arr_vals
            elif val_type == self.GGUF_VAL_BOOL:
                val, pos = self._read_value(data, pos, val_type)
                self.metadata[key] = val
            elif val_type in self._VAL_SIZES:
                val, pos = self._read_value(data, pos, val_type)
                self.metadata[key] = val
            else:
                raise ValueError(f"Unknown metadata value type {val_type} for key '{key}'")

            if key == 'general.alignment':
                alignment = max(int(self.metadata[key]), 8)
                if alignment % 8 != 0:
                    raise ValueError(f"general.alignment must be a multiple of 8: {alignment}")

        self.alignment = alignment
        # No alignment between metadata end and tensor_info start (spec: sequential).
        # Tensor_info entries themselves are also sequential without padding.
        raw_tensors: list[tuple] = []
        for _ in range(tensor_count):
            name_len = struct.unpack_from('<Q', data, pos)[0]
            pos += 8
            name = data[pos:pos + name_len].decode('utf-8')
            pos += name_len

            # SPEC field order: n_dims, dimensions[n_dims], dtype, data_offset
            n_dims = struct.unpack_from('<I', data, pos)[0]
            pos += 4

            # Batched dimension read
            shape = list(struct.unpack_from(f'<{n_dims}Q', data, pos))
            pos += n_dims * 8

            dtype = struct.unpack_from('<I', data, pos)[0]
            pos += 4

            data_offset = struct.unpack_from('<Q', data, pos)[0]
            pos += 8

            raw_tensors.append((name, n_dims, shape, dtype, data_offset))

        # Align after tensor_info block (GGUF _padding[] requirement)
        pos = self._align(pos, alignment)
        self.tensor_data_start = pos

        # Parallel phase: compute elem_count, size_bytes, dtype_name per tensor.
        # Threshold: thread pool overhead only pays off with many tensors.
        PARALLEL_THRESHOLD = 32
        self._parallel_used = self.parallel and len(raw_tensors) > PARALLEL_THRESHOLD
        if self._parallel_used:
            import concurrent.futures
            def _compute(name, n_dims, shape, dtype, data_offset):
                elem_count = math.prod(shape) if shape else 1
                if dtype in self._GGML_TYPE_SIZES:
                    bpb, blk = self._GGML_TYPE_SIZES[dtype]
                    n_blocks = (elem_count + blk - 1) // blk if blk > 1 else elem_count
                    size_bytes = (n_blocks if blk > 1 else elem_count) * bpb
                else:
                    size_bytes = elem_count * 4
                return (name, {
                    'name': name, 'dtype': dtype,
                    'dtype_name': self._DTYPE_NAMES.get(dtype, f'dt{dtype}'),
                    'shape': list(reversed(shape)),
                    'n_dims': n_dims, 'elem_count': elem_count,
                    'size_bytes': size_bytes,
                    'data_offset': data_offset,
                })

            workers = self.max_workers or min(len(raw_tensors), os.cpu_count() or 4)
            with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as ex:
                futures = {ex.submit(_compute, *rt): rt[0] for rt in raw_tensors}
                results = {}
                for fut in concurrent.futures.as_completed(futures):
                    name, info = fut.result()
                    results[name] = info
                for rt in raw_tensors:
                    name = rt[0]
                    self.tensors[name] = results[name]
        else:
            # Single-threaded path (simpler, fewer allocations for small models)
            for name, n_dims, shape, dtype, data_offset in raw_tensors:
                elem_count = math.prod(shape) if shape else 1
                if dtype in self._GGML_TYPE_SIZES:
                    bpb, blk = self._GGML_TYPE_SIZES[dtype]
                    if blk > 1:
                        n_blocks = (elem_count + blk - 1) // blk
                        size_bytes = n_blocks * bpb
                    else:
                        size_bytes = elem_count * bpb
                else:
                    size_bytes = elem_count * 4

                self.tensors[name] = {
                    'name': name, 'dtype': dtype,
                    'dtype_name': self._DTYPE_NAMES.get(dtype, f'dt{dtype}'),
                    'shape': list(reversed(shape)),
                    'n_dims': n_dims, 'elem_count': elem_count,
                    'size_bytes': size_bytes,
                    'data_offset': data_offset,
                }
        self.load_time_sec = time.perf_counter() - t0
        return self.tensors

    def get_tensor_view(self, name: str) -> memoryview:
        if name not in self.tensors:
            raise KeyError(f'Tensor not found: {name}')
        ti = self.tensors[name]
        start = self.tensor_data_start + ti['data_offset']
        end = start + ti['size_bytes']
        return self._mmap[start:end]

    def get_tokens(self) -> list:
        """Return tokenizer.ggml.tokens (array of STRING) as a list of str.
        load() skips large tokenizer arrays for memory; this reads them on demand
        from the mmap by re-scanning the metadata section (spec: type,len then
        length-prefixed strings). Returns None if absent."""
        if not self._mmap:
            self.load()
        data = self._mmap
        n = len(data)
        _version, tensor_count, meta_kv = struct.unpack_from('<IQQ', data, 4)
        pos = 24
        size_map = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}
        for _ in range(meta_kv):
            kl = struct.unpack_from('<Q', data, pos)[0]; pos += 8
            key = data[pos:pos + kl].decode('utf-8'); pos += kl
            vt = struct.unpack_from('<I', data, pos)[0]; pos += 4
            if vt == self.GGUF_VAL_STRING:
                slen = struct.unpack_from('<Q', data, pos)[0]; pos += 8
                pos += slen
            elif vt == self.GGUF_VAL_ARRAY:
                at = struct.unpack_from('<I', data, pos)[0]; pos += 4
                al = struct.unpack_from('<Q', data, pos)[0]; pos += 8
                if key == 'tokenizer.ggml.tokens' and at == self.GGUF_VAL_STRING:
                    toks = []
                    for _ in range(al):
                        slen = struct.unpack_from('<Q', data, pos)[0]; pos += 8
                        toks.append(data[pos:pos + slen].decode('utf-8')); pos += slen
                    return toks
                if at == self.GGUF_VAL_STRING:
                    for _ in range(al):
                        slen = struct.unpack_from('<Q', data, pos)[0]; pos += 8; pos += slen
                elif at in size_map:
                    pos += al * size_map[at]
                else:
                    pos = self._skip_array_elements(data, pos, at, al, n)
            elif vt in size_map:
                pos += size_map[vt]
            else:
                pos = self._skip_string(data, pos, n)
        return None

    def get_merges(self) -> list:
        """Return tokenizer.ggml.merges (array of STRING, 'token1 token2') as a list of
        (tok_a, tok_b) pairs. Same on-demand array reader as get_tokens()."""
        if not self._mmap:
            self.load()
        data = self._mmap
        n = len(data)
        _version, tensor_count, meta_kv = struct.unpack_from('<IQQ', data, 4)
        pos = 24
        size_map = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}
        for _ in range(meta_kv):
            kl = struct.unpack_from('<Q', data, pos)[0]; pos += 8
            key = data[pos:pos + kl].decode('utf-8'); pos += kl
            vt = struct.unpack_from('<I', data, pos)[0]; pos += 4
            if vt == self.GGUF_VAL_STRING:
                slen = struct.unpack_from('<Q', data, pos)[0]; pos += 8
                pos += slen
            elif vt == self.GGUF_VAL_ARRAY:
                at = struct.unpack_from('<I', data, pos)[0]; pos += 4
                al = struct.unpack_from('<Q', data, pos)[0]; pos += 8
                if key == 'tokenizer.ggml.merges' and at == self.GGUF_VAL_STRING:
                    merges = []
                    for _ in range(al):
                        slen = struct.unpack_from('<Q', data, pos)[0]; pos += 8
                        s = data[pos:pos + slen].decode('utf-8'); pos += slen
                        parts = s.split(' ')
                        merges.append((parts[0], parts[1]) if len(parts) >= 2 else (s, ''))
                    return merges
                if at == self.GGUF_VAL_STRING:
                    for _ in range(al):
                        slen = struct.unpack_from('<Q', data, pos)[0]; pos += 8; pos += slen
                elif at in size_map:
                    pos += al * size_map[at]
                else:
                    pos = self._skip_array_elements(data, pos, at, al, n)
            elif vt in size_map:
                pos += size_map[vt]
            else:
                pos = self._skip_string(data, pos, n)
        return None

    def perf_trace(self) -> dict:
        if not self.tensors:
            return {}

        dtype_counts: dict[str, int] = {}
        dtype_bytes_map: dict[str, int] = {}
        for ti in self.tensors.values():
            dt = ti['dtype_name']
            dtype_counts[dt] = dtype_counts.get(dt, 0) + 1
            dtype_bytes_map[dt] = dtype_bytes_map.get(dt, 0) + ti['size_bytes']

        total_bytes = sum(ti['size_bytes'] for ti in self.tensors.values())
        total_elems = sum(ti['elem_count'] for ti in self.tensors.values())

        arch = self.metadata.get('general.architecture', 'unknown')
        emb = self.metadata.get('llama.embedding_length',
              self.metadata.get('mpt.embedding_length',
              self.metadata.get('gpt2.embedding_length',
              self.metadata.get('phi3.embedding_length',
              self.metadata.get('qwen2.embedding_length',
              self.metadata.get('qwen2.5.embedding_length', 0))))))
        layers = self.metadata.get('llama.block_count',
            self.metadata.get('mpt.block_count',
            self.metadata.get('gpt2.block_count',
            self.metadata.get('phi3.block_count',
            self.metadata.get('qwen2.block_count',
            self.metadata.get('qwen2.5.block_count', 0))))))
        ctx = self.metadata.get('llama.context_length', 2048)

        layer_prefixes = set()
        for name in self.tensors:
            if name.startswith('blk.') or name.startswith('layers.'):
                layer_prefixes.add('.'.join(name.split('.')[:2]))

        return {
            'trace_tag': 'gguf_load',
            'load_time_ms': round(self.load_time_sec * 1000, 2),
            'parallel': self._parallel_used,
            'file_path': os.path.basename(self.path),
            'file_size_mb': round(os.path.getsize(self.path) / 1024**2, 2),
            'tensor_count': len(self.tensors),
            'total_elements': total_elems,
            'total_bytes': total_bytes,
            'dtype_breakdown': [{'dtype': dt, 'count': c, 'bytes': dtype_bytes_map[dt]}
                               for dt, c in sorted(dtype_counts.items())],
            'architecture': arch,
            'embedding_length': emb,
            'block_count': layers,
            'context_length': ctx,
            'alignment': self.alignment,
            'tensor_data_start': self.tensor_data_start,
            'layer_prefixes': sorted(layer_prefixes)[:5],
            'memory_strategy': 'zero-copy mmap (no host-to-GPU copy)',
            'quantization': 'preserved in-file format (no dequant to RAM or VRAM)',
            'io_path': 'disk -> OS page cache -> CPU mmap -> GPU staging (lazy, on-demand)',
        }

    def close(self):
        if self._mmap:
            self._mmap.close()
        if self._fd:
            self._fd.close()

    def describe_architecture(self) -> dict:
        """Describe model architecture from metadata for kernel planning."""
        arch = self.metadata.get('general.architecture', 'unknown')
        emb = int(self.metadata.get('llama.embedding_length',
              self.metadata.get('mpt.embedding_length',
              self.metadata.get('gpt2.embedding_length',
              self.metadata.get('phi3.embedding_length',
              self.metadata.get('qwen2.embedding_length',
              self.metadata.get('qwen2.5.embedding_length', 0)))))))
        layers = int(self.metadata.get('llama.block_count',
              self.metadata.get('mpt.block_count',
              self.metadata.get('gpt2.block_count',
              self.metadata.get('phi3.block_count',
              self.metadata.get('qwen2.block_count',
              self.metadata.get('qwen2.5.block_count', 0)))))))
        ctx = int(self.metadata.get('llama.context_length', 2048))
        vocab = int(self.metadata.get('llama.vocab_size', 32000))
        
        # Determine tensor layout patterns
        tensor_prefixes = set()
        for name in self.tensors:
            parts = name.split('.')
            if parts[0] in ('blk', 'layers', 'model'):
                tensor_prefixes.add(parts[0] if parts[0] == 'blk' else parts[0] + '.' + parts[1])
        
        return {
            'architecture': arch,
            'hidden_size': emb,
            'num_layers': layers,
            'context_length': ctx,
            'vocab_size': vocab,
            'tensor_prefixes': sorted(tensor_prefixes)[:10],
            'tensor_layout': 'phi3' if 'phi3' in arch.lower() else 'llama',
            'has_fused_qkv': any('attn_qkv' in k for k in self.tensors),
            'has_gate': any('ffn_gate' in k or 'ffn_up' in k for k in self.tensors),
        }

    def plan_forward_pass(self, seq_pos: int) -> list[str]:
        """Plan the sequence of GPU kernels needed for one transformer layer forward pass.
        Returns ordered list of kernel names. Assumes Phi-3 style."""
        arch = self.describe_architecture()
        plan = [
            'rmsnorm',           # attn_norm
            'matvec_fused',      # attn_qkv projection (fused QKV)
            'rope',              # apply rotary positional embedding to Q, K
            'attention_scores',  # compute Q·K^T (reuse existing attention shader)
            'softmax',           # causal softmax over keys
            'matvec_fused',      # attn_output projection
            'rmsnorm',           # ffn_norm
            'matvec_fused',      # ffn_up + ffn_gate
            'silu_mul',          # silu(gate) * up
            'matvec_fused',      # ffn_down
        ]
        if arch['has_gate']:
            # Phi-style gated MLP uses silu_mul
            pass
        return plan


class DeadlineScheduler:
    """Schedule work items to meet a deadline.

    Uses a greedy approach: assign each item to the queue with earliest
    available time, respecting dependencies.
    """

    def __init__(self, deadline_us: float):
        self.deadline_us = deadline_us
        self.queues: list[Queue] = []

    @dataclass
    class Queue:
        qid: int
        available_at: float = 0.0
        ops: list[ComputeOp] = field(default_factory=list)

    def schedule(self, ops: list[ComputeOp], caps: GpuCaps) -> list[tuple[int, ComputeOp]]:
        """Assign ops to queues, return list of (queue_id, op)."""
        for i in range(len(self.queues), caps.eu_count):
            self.queues.append(self.Queue(qid=i))

        result = []
        current_time = 0.0
        for op in ops:
            # Find the queue with earliest availability
            best_q = min(self.queues, key=lambda q: q.available_at)
            est = caps.estimate_time_us(op)
            best_q.ops.append(op)
            best_q.available_at += est
            result.append((best_q.qid, op))
            current_time = max(current_time, best_q.available_at)

            if current_time > self.deadline_us:
                # Can't meet deadline - return partial result
                return result[:-1]

        return result


def make_matvec_f32(rows: int, k: int, dtype: DType = DType.F32, wg: int = 64) -> ComputeOp:
    op = ComputeOp(
        op=Op.MatVecF32,
        name="matvec_f32",
        wg_size=wg,
        dispatch_x=(rows + wg - 1) // wg,
        extra_params={"rows": rows, "k": k, "dtype": dtype.name},
    )
    in_mat = Tensor(dtype=dtype, size=rows * k, rows=rows, cols=k)
    in_vec = Tensor(dtype=dtype, size=k, rows=k, cols=1)
    out = Tensor(dtype=DType.F32, size=rows, rows=rows, cols=1)
    out.cost_flops = float(rows * k * 2)
    op.inputs = [in_mat, in_vec]
    op.out = out
    return op


def make_attention(n: int, d: int, wg: int = 64) -> ComputeOp:
    op = ComputeOp(
        op=Op.Attention,
        name="attention",
        wg_size=wg,
        dispatch_x=n,
        extra_params={"n": n, "d": d},
    )
    hidden = Tensor(dtype=DType.F32, size=n * d * 2, rows=n, cols=d * 2)
    hidden.cost_flops = float(n * d * 2)
    scores = Tensor(dtype=DType.F32, size=n * n, rows=n, cols=n)
    scores.cost_flops = float(n * n)
    op.inputs = [hidden]
    op.out = scores
    return op
