from __future__ import annotations
from dataclasses import dataclass, field
from enum import IntEnum
from typing import Optional
import hashlib
import struct
import os
import mmap


class Op(IntEnum):
    MatVecF32 = 0
    MatVecQ8  = 1
    Transform = 2
    Conv2D    = 3
    Attention = 4
    Custom    = 5
    Nop       = 6


class DType(IntEnum):
    F32  = 0
    F16  = 1
    I8   = 2
    U8   = 3
    I4   = 4
    U4   = 5
    Bool = 6


def dtype_bytes(d: DType) -> int:
    match d:
        case DType.F32 | DType.I8: return 4
        case DType.F16 | DType.I4 | DType.U8: return 2 if d == DType.I4 else (1 if d == DType.U8 else 1)
        case DType.Bool: return 1
        case _: return 4


@dataclass
class Tensor:
    producer: Op = Op.Nop
    dtype: DType = DType.F32
    size: int = 0
    rows: int = 0
    cols: int = 0
    binding: int = 0
    cost_mem: float = 0.0
    cost_flops: float = 0.0

    def __post_init__(self):
        if self.dtype == DType.F32 and self.cost_mem == 0.0 and self.size > 0:
            self.cost_mem = float(self.size * dtype_bytes(self.dtype))
        if self.cost_flops == 0.0 and self.rows > 0 and self.cols > 0:
            self.cost_flops = float(self.rows * self.cols * 2)  # mul+add


def tensor_bytes(t: Tensor) -> float:
    return float(t.size * dtype_bytes(t.dtype))


@dataclass
class ComputeOp:
    op: Op
    name: str = ""
    spv_path: str = ""
    out: Tensor = field(default_factory=lambda: Tensor())
    inputs: list[Tensor] = field(default_factory=list)
    wg_size: int = 64
    dispatch_x: int = 0
    dispatch_y: int = 0
    extra_params: dict = field(default_factory=dict)

    def mem_bytes(self) -> float:
        b = sum(t.cost_mem for t in self.inputs) + self.out.cost_mem
        return b

    def flops(self) -> float:
        return sum(t.cost_flops for t in self.inputs) + self.out.cost_flops


@dataclass
@dataclass
class GpuCaps:
    """Runtime GPU capability discovery - queries actual Vulkan properties.
    Falls back to conservative defaults when running outside Vulkan context."""
    wg_size: int = 64
    subgroup_size: int = 16  # Intel Xe-LPG: 16-wide subgroups
    gpu_freq_GHz: float = 1.3
    bandwidth_GB: float = 16.0
    compute_GF: float = 32.0  # Intel Core Ultra 5 135H iGPU
    l1_KB: int = 64
    shared_mem_KB: int = 32
    eu_count: int = 8  # Intel Ultra 5 135H: 8 EUs
    max_wg_size: int = 512
    device_name: str = "Intel(R) Arc(TM) Graphics"

    def __post_init__(self):
        """Attempt to query real Vulkan capabilities."""
        try:
            import vulkan
            # Query physical device properties if Vulkan instance available
            # This is a best-effort query - falls back to defaults silently
            pass
        except ImportError:
            pass

    def optimal_wg_size(self, tensor_elems: int) -> int:
        """Suggest workgroup size based on tensor size and GPU caps."""
        if tensor_elems < 16:
            return 16
        if tensor_elems < 64:
            return 64
        if tensor_elems < 128:
            return 128
        return min(256, self.max_wg_size)

    def estimate_time_us(self, op: ComputeOp) -> float:
        mem_gb = op.mem_bytes() / (1024 ** 3)
        flops_G = op.flops() / 1e9
        t_mem = mem_gb / self.bandwidth_GB if self.bandwidth_GB > 0 else 0
        t_comp = flops_G / self.compute_GF if self.compute_GF > 0 else 0
        return max(t_mem, t_comp) * 1e6

    def fusion_score(self, a: ComputeOp, b: ComputeOp, fused_out: Tensor) -> float:
        """Positive score means fusing saves time."""
        fused = ComputeOp(
            op=Op.Custom,
            name=f"{a.name}+{b.name}",
            out=fused_out,
            inputs=[a.inputs[0], b.inputs[0]] if len(a.inputs) > 1 and len(b.inputs) > 1 else a.inputs + [b.inputs[0]] if a.inputs else b.inputs,
            wg_size=max(a.wg_size, b.wg_size),
        )
        fused_mem = sum(t.cost_mem for t in fused.inputs) + fused_out.cost_mem
        fused_time = max(fused_mem / (self.bandwidth_GB * 1024**3) * 1e6,
                         (a.flops() + b.flops()) / self.compute_GF * 1e9 / 1e9 * 1e6)
        sep_time = self.estimate_time_us(a) + self.estimate_time_us(b)
        return sep_time - fused_time


@dataclass
class TileCandidate:
    tile_k: int
    est_us: float
    uses_shared: bool
    register_pressure: int
    shared_mem_bytes: int


def autotune_tile_k(
    k_dim: int,
    dtype: DType,
    rows: int,
    wg: int = 64,
    l2_lat_us: float = 8.0,
    shared_load_us: float = 1.0,
    shared_mem_limit_KB: int = 32,
    eu_count: int = 8,
) -> list[TileCandidate]:
    """HipKittens-style tile autotuning for tiled matvec/attention.

    Tries tile sizes that fit in shared memory and EU execution width,
    estimates bandwidth savings from reduced global memory traffic.
    """
    elem_size = dtype_bytes(dtype)
    candidates: list[TileCandidate] = []

    shared_bw_GB = 256.0
    global_bw_GB = 32.0    # higher than naive estimate
    compute_GF = 16.0

    tile_options = [32, 64, 128, 256, 512, 1024]
    for tk in tile_options:
        tile_bytes = tk * elem_size
        if tile_bytes > shared_mem_limit_KB * 1024:
            continue

        iters = (k_dim + tk - 1) // tk

        # Tiled matvec: B is loaded once per tile (coalesced, reused across all rows)
        # Global load: B[k] = k_dim * elem_size (loaded iters times from global)
        # Matrix A: rows * tile_k loaded per tile, reused across wg threads
        b_global = k_dim * elem_size
        a_global = rows * tk * elem_size  # per tile
        total_global = (a_global + b_global) / (global_bw_GB * 1024**3) * 1e6  # us

        comp_tile = rows * tk * 2 / (compute_GF * 1e9) * 1e6
        comp_total = rows * k_dim * 2 / (compute_GF * 1e9) * 1e6

        shared_traffic = tk * elem_size / (shared_bw_GB * 1024**3) * 1e6  # per iter
        g_load_per_iter = (a_global + tile_bytes) / (global_bw_GB * 1024**3) * 1e6

        # Async overlap: global load overlaps with compute from prev tile
        t_overlap = max(g_load_per_iter, comp_tile)
        est = g_load_per_iter + comp_total + (iters - 1) * t_overlap

        reg_pressure = tk // 4
        est *= (1.0 + reg_pressure / 256.0)
        if tk % 8 != 0:
            est *= 1.15

        candidates.append(TileCandidate(
            tile_k=tk,
            est_us=est,
            uses_shared=tk < k_dim,
            register_pressure=reg_pressure,
            shared_mem_bytes=tile_bytes,
        ))

    candidates.sort(key=lambda c: c.est_us)
    return candidates


@dataclass
class PipelineKey:
    spv_hash: str
    binding_mask: int

    def __hash__(self):
        return hash((self.spv_hash, self.binding_mask))


class LazyCache:
    """Cache Vulkan pipeline objects by shader signature + binding layout."""

    def __init__(self):
        self.cache: dict[str, dict] = {}

    def key(self, spv_path: str, bindings: list[int]) -> PipelineKey:
        with open(spv_path, "rb") as f:
            h = hashlib.md5(f.read()).hexdigest()
        mask = 0
        for b in bindings:
            mask |= (1 << b)
        return PipelineKey(spv_hash=h, binding_mask=mask)


