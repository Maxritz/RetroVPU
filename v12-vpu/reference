        f.write(bytes.fromhex(pc_hex))

# ── Save/load binary ──────────────────────────────────────────────

def save_binary(path: str, data: np.ndarray):
    data = np.ascontiguousarray(data)
    with open(path, 'wb') as f:
        f.write(data.tobytes())

def save_bytes(path: str, data: bytes):
    with open(path, 'wb') as f:
        f.write(data)

def save_floats(path: str, floats):
    with open(path, 'wb') as f:
        for v in floats:
            f.write(struct.pack('<f', float(v)))


# ── Workload: attention ────────────────────────────────────────────

HEAD_DIM = 64

def gen_attention_data(n: int, head_dim: int = HEAD_DIM, seed: int = 42):
    """Generate hidden states and reference attention output (simplified self-attention)."""
    rng = np.random.default_rng(seed)
    hidden = rng.standard_normal(n * head_dim).astype(np.float32) * 0.1
    ref = ref_attention(hidden, n, head_dim)
    return hidden, ref

def ref_attention(hidden, n: int, head_dim: int = HEAD_DIM):
    """Compute scaled dot-product attention scores matrix (n x n)."""
    h = hidden.reshape(n, head_dim)
    scores = np.zeros((n, n), dtype=np.float32)
    for i in range(n):
        for j in range(n):
            scores[i, j] = np.dot(h[i], h[j]) / np.sqrt(head_dim)
    return scores.flatten()
